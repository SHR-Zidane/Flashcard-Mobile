<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="Flashcard_Mobile.Views.DeckFormPage"
    BackgroundColor="Black">

    <ScrollView>
        <VerticalStackLayout Padding="20,20,20,30" Spacing="14">
            <Label
                x:Name="TitleLabel"
                Text="Creer un deck"
                FontSize="24"
                TextColor="White"
                Margin="0,0,0,10" />

            <Frame BackgroundColor="#F0F0F0" BorderColor="Transparent">
                <VerticalStackLayout Spacing="14">
                    <Label Text="Nom" FontSize="14" TextColor="Black" />
                    <Entry x:Name="NameEntry" Placeholder="Nom du deck" />

                    <Label Text="Liste" FontSize="14" TextColor="Black" Margin="0,8,0,0" />
                    <Entry x:Name="ListEntry" Placeholder="Nom de la liste" />

                    <Button
                        x:Name="SaveButton"
                        Text="Enregistrer"
                        BackgroundColor="{StaticResource Tertiary}"
                        TextColor="White"
                        Clicked="OnSaveClicked" />
                </VerticalStackLayout>

            </Frame>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
