<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="Flashcard_Mobile.Views.StudyPage"
    BackgroundColor="Black">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Arrêter" Command="{Binding QuitCommand}" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="*,Auto,Auto" Padding="20">
        <Frame
            Grid.Row="0"
            x:Name="CardFrame"
            BackgroundColor="#F0F0F0"
            CornerRadius="10"
            Margin="0,20"
            VerticalOptions="Center">
            <Grid RowDefinitions="*,Auto" VerticalOptions="Center">
                <Label
                    Grid.Row="0"
                    x:Name="FrontLabel"
                    Text="{Binding CurrentFront}"
                    FontSize="24"
                    FontAttributes="Bold"
                    TextColor="Black"
                    HorizontalOptions="Center"
                    VerticalOptions="Center" />

                <Label
                    Grid.Row="0"
                    x:Name="BackLabel"
                    Text="{Binding CurrentBack}"
                    FontSize="20"
                    TextColor="{StaticResource Gray600}"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    IsVisible="False" />

                <Label
                    Grid.Row="1"
                    x:Name="HintLabel"
                    Text="Appuyez pour voir la reponse"
                    FontSize="14"
                    TextColor="{StaticResource Gray500}"
                    HorizontalOptions="Center"
                    Margin="0,10,0,0" />
            </Grid>

            <Frame.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding ShowAnswerCommand}" />
            </Frame.GestureRecognizers>
        </Frame>

        <Grid
            Grid.Row="1"
            ColumnDefinitions="*,*"
            ColumnSpacing="20"
            Margin="0,0,0,20"
            IsVisible="{Binding ShowButtons}">
            <Button
                Grid.Column="0"
                Text="Correct"
                BackgroundColor="{StaticResource Tertiary}"
                TextColor="White"
                Command="{Binding CorrectCommand}"
                HeightRequest="50" />
            <Button
                Grid.Column="1"
                Text="Faux"
                BackgroundColor="{StaticResource Gray500}"
                TextColor="White"
                Command="{Binding IncorrectCommand}"
                HeightRequest="50" />
        </Grid>

        <VerticalStackLayout
            Grid.Row="2"
            IsVisible="{Binding ShowResult}"
            Spacing="8">
            <Label
                Text="Résumé de la session"
                FontSize="22"
                FontAttributes="Bold"
                TextColor="White"
                HorizontalOptions="Center"
                Margin="0,0,0,10" />
            <Label
                Text="{Binding TimeSpentText}"
                FontSize="16"
                TextColor="White"
                HorizontalOptions="Center" />
            <Label
                Text="{Binding HardestCardText}"
                FontSize="16"
                TextColor="White"
                HorizontalOptions="Center" />
            <Label
                Text="{Binding FullyKnownText}"
                FontSize="16"
                TextColor="White"
                HorizontalOptions="Center" />
            <Label
                Text="{Binding MemorizationText}"
                FontSize="16"
                TextColor="#4CAF50"
                HorizontalOptions="Center"
                Margin="0,5,0,0" />
            <Button
                Text="Quitter"
                BackgroundColor="{StaticResource Gray600}"
                TextColor="White"
                Command="{Binding QuitCommand}"
                HeightRequest="50" />
            <Button
                Text="Recommencer"
                BackgroundColor="{StaticResource Tertiary}"
                TextColor="White"
                Command="{Binding RestartCommand}"
                HeightRequest="50" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
